# ── PostgreSQL (Supabase / Railway PG / Neon) ────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=https://all-in-one-pi-flax.vercel.app
