# Copy this to .env for local development
PORT=5000
NODE_ENV=production

# ── Aiven MySQL ──────────────────────────────────────────────
# Get these from: Aiven Console → Your Service → Connection Info
DB_HOST=your-service.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=all_in_one_tour

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=https://all-in-one-pi-flax.vercel.app
